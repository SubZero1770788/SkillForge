@model quiz_project.ViewModels.ModuleContentViewModel

<h2 class="mb-3">@Model.Title</h2>

@if (!string.IsNullOrWhiteSpace(Model.Description))
{
    <div class="card p-4 mb-4">
        <p style="white-space: pre-wrap">@Model.Description</p>
    </div>
}

@if (!string.IsNullOrEmpty(Model.RoadmapFilePath))
{
    <div class="mb-4">
        <h5>Module attachment</h5>
        <a href="/Module/Download?moduleId=@Model.ModuleId"
           class="btn btn-outline-secondary" target="_blank">
            Download file
        </a>
    </div>
}

@if (Model.QuizId.HasValue)
{
    <div class="mb-4">
        <h5>Module Quiz</h5>
        <a href="/QuizGame/Index?quizId=@Model.QuizId" class="btn btn-primary">
            @(Model.QuizPassed ? "Retake quiz" : "Start quiz")
        </a>
        @if (Model.RequireQuizPass && Model.QuizPassed)
        {
            <span class="badge bg-success ms-2">✓ Passed</span>
        }
        else if (Model.RequireQuizPass && !Model.QuizPassed)
        {
            <div class="alert alert-warning mt-3 mb-0">
                You must pass this quiz to complete the module and unlock the next one.
            </div>
        }
    </div>
}
