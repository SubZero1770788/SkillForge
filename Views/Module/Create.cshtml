@model quiz_project.ViewModels.ModuleViewModel

<div class="form-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Add Module</h1>
        <a asp-controller="Course" asp-action="Edit" asp-route-courseId="@Model.CourseId"
           class="btn btn-secondary">Back to course</a>
    </div>

    <form method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="CourseId" />
        <div class="col-md-6">
            <div class="form-group mb-3">
                <label asp-for="Title"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Order">Order (position in course)</label>
                <input asp-for="Order" type="number" min="0" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label for="file">Attachment (PDF or 7z, optional)</label>
                <input type="file" id="file" name="file" class="form-control"
                       accept=".pdf,.7z,.zip" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="QuizId">Module quiz (optional)</label>
                <select asp-for="QuizId" class="form-select">
                    <option value="">- none-</option>
                    @if (ViewBag.AvailableQuizzes != null)
                    {
                        @foreach (var quiz in ViewBag.AvailableQuizzes)
                        {
                            <option value="@quiz.QuizId">@quiz.Title</option>
                        }
                    }
                </select>
            </div>

            <div asp-validation-summary="All" class="text-danger mb-2"></div>
            <button type="submit" class="btn btn-primary">Add module</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
