@model quiz_project.ViewModels.CourseViewModel

<div class="form-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Edit Course</h1>
        <a asp-action="Index" class="btn btn-secondary">Back to courses</a>
    </div>

    <div class="row">
        <div class="col-md-5">
            <form method="post">
                <div class="form-group mb-3">
                    <label asp-for="Title"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Description"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label>Make course public?</label>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" asp-for="IsPublic" value="true" id="public-yes" />
                        <label class="form-check-label" for="public-yes">Yes</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" asp-for="IsPublic" value="false" id="public-no" />
                        <label class="form-check-label" for="public-no">No</label>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label>Require sequential completion?</label>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" asp-for="IsSequential" value="true" id="seq-yes" />
                        <label class="form-check-label" for="seq-yes">Yes</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" asp-for="IsSequential" value="false" id="seq-no" />
                        <label class="form-check-label" for="seq-no">No</label>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label>Require approval to join?</label>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" asp-for="IsPaid" value="true" id="paid-yes" />
                        <label class="form-check-label" for="paid-yes">Yes — enrollment requires creator approval</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" asp-for="IsPaid" value="false" id="paid-no" />
                        <label class="form-check-label" for="paid-no">No — anyone can join freely</label>
                    </div>
                </div>

                <div asp-validation-summary="All" class="text-danger mb-2"></div>
                <button type="submit" class="btn btn-primary">Save changes</button>
            </form>
        </div>

        <div class="col-md-7">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4>Modules</h4>
                <a asp-controller="Module" asp-action="Create" asp-route-courseId="@Model.CourseId"
                   class="btn btn-success btn-sm">+ Add module</a>
            </div>

            @if (!Model.Modules.Any())
            {
                <div class="alert alert-info">This course has no modules yet.</div>
            }
            else
            {
                <div id="module-list">
                    @foreach (var module in Model.Modules.OrderBy(m => m.Order))
                    {
                        <div class="card mb-2 module-item" data-id="@module.ModuleId" style="cursor: grab">
                            <div class="card-body d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="drag-handle text-muted me-2">⠿</span>
                                    <strong>@module.Title</strong>
                                    <small class="text-muted ms-2">@module.Chapters.Count chapter(s)</small>
                                </div>
                                <div>
                                    <a asp-controller="Module" asp-action="Edit" asp-route-moduleId="@module.ModuleId"
                                       class="btn btn-outline-primary btn-sm me-1">Edit</a>
                                    <form asp-controller="Module" asp-action="Delete" method="post" class="d-inline">
                                        <input type="hidden" name="moduleId" value="@module.ModuleId" />
                                        <input type="hidden" name="courseId" value="@Model.CourseId" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm"
                                                onclick="return confirm('Delete this module?')">Delete</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <form id="reorder-form" asp-controller="Module" asp-action="Reorder" method="post">
                    <input type="hidden" name="courseId" value="@Model.CourseId" />
                    <div id="reorder-inputs"></div>
                    <button type="submit" class="btn btn-outline-secondary btn-sm mt-2">Save order</button>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
    <script>
        const list = document.getElementById('module-list');
        if (list) {
            Sortable.create(list, { animation: 150, handle: '.drag-handle' });

            document.getElementById('reorder-form').addEventListener('submit', function () {
                const inputs = document.getElementById('reorder-inputs');
                inputs.innerHTML = '';
                [...list.querySelectorAll('.module-item')].forEach((el, i) => {
                    inputs.innerHTML +=
                        `<input type="hidden" name="items[${i}].Id" value="${el.dataset.id}">` +
                        `<input type="hidden" name="items[${i}].Order" value="${i}">`;
                });
            });
        }
    </script>
}
