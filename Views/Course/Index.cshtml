@model List<quiz_project.ViewModels.CourseViewModel>

<div class="stats-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h3 class="mb-0">My Courses</h3>
        <div class="d-flex gap-2 align-items-center flex-wrap">
            <div class="input-group" style="max-width: 280px;">
                <span class="input-group-text bg-white border-end-0">&#128269;</span>
                <input id="grid-search" type="search" class="form-control border-start-0"
                       placeholder="Search courses…" autocomplete="off" />
            </div>
            <a class="btn btn-primary text-white" asp-controller="Course" asp-action="Create">
                Create course
            </a>
        </div>
    </div>
    <p id="search-empty" class="text-muted d-none">No courses match your search.</p>

    @{ await Html.RenderPartialAsync("~/Views/Shared/_CourseDetails.cshtml"); }

    <div id="course-pager" data-pager></div>
</div>

@section Scripts {
    <script>
        initGridSearch('grid-search', '.quiz-card', 'search-empty');
        initGridPagination('.quiz-card', 'course-pager', 9);
    </script>
}
