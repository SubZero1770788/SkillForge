@model List<quiz_project.ViewModels.EnrolledCourseViewModel>
@using quiz_project.Entities

<div class="stats-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h3 class="mb-0">My Courses</h3>
        <div class="input-group" style="max-width: 280px;">
            <span class="input-group-text bg-white border-end-0">&#128269;</span>
            <input id="grid-search" type="search" class="form-control border-start-0"
                   placeholder="Search courses…" autocomplete="off" />
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You are not enrolled in any courses yet.
            <a asp-controller="Menu" asp-action="BrowseCourses" class="alert-link ms-1">Browse courses</a>
        </div>
    }
    else
    {
        <p id="search-empty" class="text-muted d-none">No courses match your search.</p>
        <div class="quiz-grid">
            @foreach (var course in Model)
            {
                <div class="quiz-card course-card"
                     data-search="@((course.Title + " " + course.Description)?.ToLower())">
                    <div class="quiz-title">@course.Title</div>
                    <div class="quiz-description">
                        @(course.Description?.Length > 120
                            ? course.Description[..120] + "…"
                            : course.Description)
                    </div>
                    <div class="quiz-meta">
                        @if (course.Status == EnrollmentStatus.Approved)
                        {
                            <span class="badge bg-success">Enrolled</span>
                        }
                        else if (course.Status == EnrollmentStatus.Pending)
                        {
                            <span class="badge bg-warning text-dark">Pending approval</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Rejected</span>
                        }
                        <span class="ms-2">@course.EnrolledAt.ToString("dd MMM yyyy")</span>
                    </div>
                    @if (course.Status == EnrollmentStatus.Approved)
                    {
                        <div class="quiz-buttons mt-auto">
                            <a asp-action="Dashboard" asp-route-courseId="@course.CourseId"
                               class="btn btn-primary text-white">Open course</a>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        initGridSearch('grid-search', '.quiz-card', 'search-empty');
    </script>
}
