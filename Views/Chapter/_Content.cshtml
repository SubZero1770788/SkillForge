@model quiz_project.ViewModels.ChapterViewModel

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@Model.Title</h2>
    @if (Model.IsCompleted)
    {
        <span class="badge bg-success fs-6">Completed</span>
    }
</div>

@if (!string.IsNullOrWhiteSpace(Model.Content))
{
    <div class="card p-4 mb-4">
        <p style="white-space: pre-wrap">@Model.Content</p>
    </div>
}

@if (!string.IsNullOrEmpty(Model.FilePath))
{
    <div class="mb-4">
        <h5>Attachment</h5>
        <a href="/Chapter/Download?chapterId=@Model.ChapterId"
           class="btn btn-outline-secondary" target="_blank">
            Download file
        </a>
    </div>
}

@if (Model.QuizId.HasValue)
{
    <div class="mb-4">
        <h5>Chapter Quiz</h5>
        <a href="/QuizGame/Index?quizId=@Model.QuizId" class="btn btn-primary">
            @(Model.QuizPassed ? "Retake quiz" : "Start quiz")
        </a>
        @if (Model.RequireQuizPass && Model.QuizPassed)
        {
            <span class="badge bg-success ms-2">✓ Passed</span>
        }
    </div>
}

@if (!Model.IsCompleted)
{
    @if (Model.RequireQuizPass && Model.QuizId.HasValue && !Model.QuizPassed)
    {
        <div class="alert alert-warning mt-2 mb-0">
            You must pass the quiz above to complete this chapter and unlock the next one.
        </div>
    }
    else
    {
        <button class="btn btn-success mt-2"
                onclick="completeChapter(@Model.ChapterId, @Model.ModuleId, this)">
            Mark as completed
        </button>
    }
}
