@model quiz_project.ViewModels.ChapterViewModel

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>@Model.Title</h1>
        @if (Model.IsCompleted)
        {
            <span class="badge bg-success fs-6">Completed</span>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Content))
    {
        <div class="chapter-content card p-4 mb-4">
            <p style="white-space: pre-wrap">@Model.Content</p>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.FilePath))
    {
        <div class="mb-4">
            <h5>Attachment</h5>
            <a href="@Model.FilePath" class="btn btn-outline-secondary" target="_blank">
                Download file
            </a>
        </div>
    }

    @if (Model.QuizId.HasValue)
    {
        <div class="mb-4">
            <h5>Chapter Quiz</h5>
            <a asp-controller="QuizGame" asp-action="Index" asp-route-quizId="@Model.QuizId"
               class="btn btn-primary">Start quiz</a>
        </div>
    }

    @if (!Model.IsCompleted)
    {
        <form asp-action="Complete" method="post" class="mt-3">
            <input type="hidden" name="chapterId" value="@Model.ChapterId" />
            <input type="hidden" name="moduleId" value="@Model.ModuleId" />
            <button type="submit" class="btn btn-success">Mark as completed</button>
        </form>
    }
</div>
