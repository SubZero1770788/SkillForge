@model quiz_project.ViewModels.ChapterViewModel

<div class="container mt-4 text-center">
    <div class="card p-5 mt-5">
        <h2>Chapter locked</h2>
        <p class="text-muted mt-3">
            Complete the previous chapter first to unlock <strong>@Model.Title</strong>.
        </p>
        <a asp-controller="Module" asp-action="Edit" asp-route-moduleId="@Model.ModuleId"
           class="btn btn-secondary mt-3">Back to module</a>
    </div>
</div>
