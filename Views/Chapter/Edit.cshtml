@model quiz_project.ViewModels.ChapterViewModel

<div class="form-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Edit Chapter</h1>
        <a asp-controller="Module" asp-action="Edit" asp-route-moduleId="@Model.ModuleId"
           class="btn btn-secondary">Back to module</a>
    </div>

    <form method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="ChapterId" />
        <input type="hidden" asp-for="ModuleId" />
        <div class="col-md-8">
            <div class="form-group mb-3">
                <label asp-for="Title"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Order">Order (position in module)</label>
                <input asp-for="Order" type="number" min="0" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Content">Content (Markdown supported)</label>
                <textarea asp-for="Content" class="form-control" rows="12"></textarea>
            </div>

            <div class="form-group mb-3">
                <label for="file">Attachment (PDF or 7z, optional)</label>
                @if (!string.IsNullOrEmpty(Model.FilePath))
                {
                    <div class="mb-1">
                        <a asp-action="Download" asp-route-chapterId="@Model.ChapterId"
                           class="btn btn-outline-secondary btn-sm" target="_blank">
                            Current file-download
                        </a>
                        <small class="text-muted ms-2">Upload a new file to replace it.</small>
                    </div>
                }
                <input type="file" id="file" name="file" class="form-control"
                       accept=".pdf,.7z,.zip" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="QuizId">Linked quiz (optional)</label>
                @* RequireQuizPass shown below after quiz selection *@
                <select asp-for="QuizId" class="form-select">
                    <option value="">- none-</option>
                    @if (ViewBag.AvailableQuizzes != null)
                    {
                        @foreach (var quiz in ViewBag.AvailableQuizzes)
                        {
                            <option value="@quiz.QuizId" selected="@(Model.QuizId == quiz.QuizId)">
                                @quiz.Title
                            </option>
                        }
                    }
                </select>
            </div>

            <div class="form-group mb-3" id="quiz-settings" style="@(Model.QuizId.HasValue ? "" : "display:none;")">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" asp-for="RequireQuizPass" />
                    <label class="form-check-label" asp-for="RequireQuizPass">
                        Require passing the quiz to unlock next chapter
                    </label>
                </div>
            </div>

            <div asp-validation-summary="All" class="text-danger mb-2"></div>
            <button type="submit" class="btn btn-primary">Save changes</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('QuizId').addEventListener('change', function () {
            document.getElementById('quiz-settings').style.display = this.value ? '' : 'none';
        });
    </script>
}
