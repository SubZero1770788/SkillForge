@model quiz_project.ViewModels.ChapterViewModel

<div class="form-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Edit Chapter</h1>
        <a asp-controller="Module" asp-action="Edit" asp-route-moduleId="@Model.ModuleId"
           class="btn btn-secondary">Back to module</a>
    </div>

    <form method="post">
        <input type="hidden" asp-for="ChapterId" />
        <input type="hidden" asp-for="ModuleId" />
        <div class="col-md-8">
            <div class="form-group mb-3">
                <label asp-for="Title"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Order">Order (position in module)</label>
                <input asp-for="Order" type="number" min="0" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Content">Content (Markdown supported)</label>
                <textarea asp-for="Content" class="form-control" rows="12"></textarea>
            </div>

            <div class="form-group mb-3">
                <label asp-for="QuizId">Linked quiz (optional)</label>
                <select asp-for="QuizId" class="form-select">
                    <option value="">— none —</option>
                    @if (ViewBag.AvailableQuizzes != null)
                    {
                        @foreach (var quiz in ViewBag.AvailableQuizzes)
                        {
                            var scopeLabel = quiz.Scope.ToString() == "Standalone" ? "" : $" [{quiz.Scope}]";
                            <option value="@quiz.QuizId" selected="@(Model.QuizId == quiz.QuizId)">
                                @quiz.Title@scopeLabel
                            </option>
                        }
                    }
                </select>
            </div>

            <div asp-validation-summary="All" class="text-danger mb-2"></div>
            <button type="submit" class="btn btn-primary">Save changes</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
