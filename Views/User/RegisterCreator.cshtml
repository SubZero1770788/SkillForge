@model quiz_project.ViewModels.RegisterCreatorViewModel
@{
    ViewBag.Title = "Creator Registration";
}

<div class="form-wrapper" style="max-width: 600px; margin: auto;">
    <h2 class="mb-1">Creator Registration</h2>
    <p class="text-muted mb-4">
        Apply to publish courses on SkillForge. Your account will be created immediately,
        but creator access requires admin approval — we'll review your application shortly.
    </p>

    <form method="post">
        <div asp-validation-summary="All" class="alert alert-danger d-none" id="val-summary"></div>

        <h5 class="mt-3 mb-3 border-bottom pb-1">Account details</h5>

        <div class="mb-3">
            <label asp-for="UserName" class="form-label"></label>
            <input asp-for="UserName" class="form-control" />
            <span asp-validation-for="UserName" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" type="email" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmedPassword" class="form-label"></label>
            <input asp-for="ConfirmedPassword" class="form-control" />
            <span asp-validation-for="ConfirmedPassword" class="text-danger small"></span>
        </div>

        <h5 class="mt-4 mb-3 border-bottom pb-1">Creator information</h5>

        <div class="mb-3">
            <label asp-for="ContactName" class="form-label"></label>
            <input asp-for="ContactName" class="form-control" placeholder="e.g. Acme Training Ltd or Jan Kowalski" />
            <span asp-validation-for="ContactName" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="4"
                      placeholder="Describe what topics you plan to cover, your experience, intended audience…"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
            <div class="form-text">Minimum 30 characters. This is shown to the admin when reviewing your application.</div>
        </div>

        <button type="submit" class="btn btn-primary w-100">Submit application</button>

        <p class="text-center mt-3 text-muted small">
            Already have an account? <a asp-action="Login">Log in</a> &nbsp;|&nbsp;
            Just a student? <a asp-action="Register">Student registration</a>
        </p>
    </form>
</div>

@section Scripts {
    <script>
        // Show validation summary if it has children
        const vs = document.getElementById('val-summary');
        if (vs && vs.querySelector('li')) vs.classList.remove('d-none');
    </script>
}
