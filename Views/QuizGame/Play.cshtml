@model quiz_project.ViewModels.GameViewModel
@using quiz_project.Entities.Definition

<h2>Page @(Model.CurrentPage) of @Model.TotalPages</h2>

<div class="mb-3">
    <h3>Enjoy solving this quiz</h3>
</div>

<form asp-action="Play" method="post">
    <input type="hidden" name="CurrentPage" value="@Model.CurrentPage" />
    <input type="hidden" name="QuizId" value="@Model.QuizId" />

    <div class="form-group">
        @for (int j = 0; j < Model.Questions.Count; j++)
        {
            var question = Model.Questions[j];
            var questionNumber = ((Model.CurrentPage - 1) * 5) + j + 1;

            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Question @questionNumber
                        <small class="text-muted ms-2">(@question.QuestionScore pts)</small>
                    </h5>

                    <p class="card-text">@question.Description</p>

                    <input type="hidden" name="Questions[@j].QuestionId" value="@question.QuestionId" />
                    <input type="hidden" name="Questions[@j].Type" value="@((int)question.Type)" />

                    @if (question.Type == QuestionType.MultipleChoice)
                    {
                        <p class="text-muted small mb-2">Select all correct answers.</p>
                        @for (int i = 0; i < question.Answers.Count; i++)
                        {
                            var answer = question.Answers[i];
                            <div class="form-check mb-1">
                                <input class="form-check-input" type="checkbox"
                                       name="Questions[@j].SelectedAnswerIds"
                                       id="answer_@(j)_@(i)"
                                       value="@answer.AnswerId" />
                                <label class="form-check-label" for="answer_@(j)_@(i)">@answer.Description</label>
                            </div>
                        }
                    }
                    else if (question.Type == QuestionType.SingleChoice)
                    {
                        <p class="text-muted small mb-2">Select one correct answer.</p>
                        @for (int i = 0; i < question.Answers.Count; i++)
                        {
                            var answer = question.Answers[i];
                            <div class="form-check mb-1">
                                <input class="form-check-input" type="radio"
                                       name="Questions[@j].SelectedAnswerIds"
                                       id="answer_@(j)_@(i)"
                                       value="@answer.AnswerId" />
                                <label class="form-check-label" for="answer_@(j)_@(i)">@answer.Description</label>
                            </div>
                        }
                    }
                    else if (question.Type == QuestionType.FillInTheBlank)
                    {
                        <p class="text-muted small mb-2">Fill in the blank.</p>
                        <input type="text"
                               name="Questions[@j].OpenText"
                               class="form-control"
                               placeholder="Your answer…"
                               autocomplete="off" />
                    }
                    else if (question.Type == QuestionType.OpenWithImage)
                    {
                        @if (!string.IsNullOrEmpty(question.ImagePath))
                        {
                            <div class="mb-3">
                                <img src="/Quiz/QuestionImage?path=@Uri.EscapeDataString(question.ImagePath)"
                                     class="img-fluid rounded"
                                     style="max-height:350px;"
                                     alt="Question image" />
                            </div>
                        }
                        <p class="text-muted small mb-2">Describe what you see or answer the question.</p>
                        <textarea name="Questions[@j].OpenText"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Your answer…"></textarea>
                    }
                </div>
            </div>
        }
    </div>

    <button type="submit" class="btn btn-primary mt-3 mb-5">
        @(Model.CurrentPage == Model.TotalPages ? "Finish" : "Next →")
    </button>
</form>
