@{
    var currentAction = ViewContext.RouteData.Values["controller"]?.ToString();
}

<div class="quiz-grid">
    @foreach (CourseViewModel courseViewModel in Model)
    {
        <div class="quiz-card">
            <div class="quiz-title">@courseViewModel?.Title</div>
            <div class="quiz-description">@courseViewModel?.Description</div>

            @if (currentAction == "Course")
            {
                <div class="quiz-meta">
                    @(courseViewModel!.IsPublic ? "Course is public" : "Course is private")
                </div>
            }

            <div class="quiz-meta">
                Total Modules: BRAK DANYCH<br />
                Total Chapters: BRAK DANYCH<br />
            </div>

            <div class="quiz-buttons no-wrap-buttons">
                <form asp-controller="Course" asp-action="Game" method="get">
                    <input type="hidden" name="CourseId" value="@courseViewModel?.CourseId" />
                    <button type="submit" class="btn btn-success text-white">View Course</button>
                </form>

                @if (currentAction == "Course" || User.IsInRole("Admin"))
                {
                    <form asp-controller="Course" asp-action="Edit" method="get">
                        <input type="hidden" name="CourseId" value="@courseViewModel?.CourseId" />
                        <button type="submit" class="btn btn-warning text-white">Edit</button>
                    </form>

                    <form asp-controller="Course" asp-action="Delete" method="post">
                        <input type="hidden" name="Id" value="@courseViewModel?.CourseId" />
                        <button type="submit" class="btn btn-danger text-white">Delete</button>
                    </form>

                    <form asp-controller="Course" asp-action="Statistics" method="get">
                        <input type="hidden" name="Id" value="@courseViewModel?.CourseId" />
                        <button type="submit" class="btn btn-info text-white">Statistics</button>
                    </form>
                }
            </div>
        </div>
    }
</div>