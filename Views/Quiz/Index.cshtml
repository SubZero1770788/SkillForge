@{
    ViewData["Title"] = "Welcome to Quizzler!";
}
@model List<quiz_project.ViewModels.QuizViewModel>

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">@ViewData["Title"]</h1>
        <div class="d-flex gap-2 align-items-center">
            <div class="input-group" style="max-width: 280px;">
                <span class="input-group-text bg-white border-end-0">&#128269;</span>
                <input id="grid-search" type="search" class="form-control border-start-0"
                       placeholder="Search quizzes…" autocomplete="off" />
            </div>
            <a class="btn btn-primary text-white" asp-area="" asp-controller="Quiz" asp-action="Create">
                Create quiz
            </a>
        </div>
    </div>
    <p id="search-empty" class="text-muted d-none">No quizzes match your search.</p>
</div>

<div class="container">
    <div class="row align-items-start">
        @{
            await Html.RenderPartialAsync("~/Views/Shared/_QuizDetails.cshtml");
        }
    </div>
</div>

@section Scripts {
    <script>
        initGridSearch('grid-search', '.quiz-card', 'search-empty');
    </script>
}
