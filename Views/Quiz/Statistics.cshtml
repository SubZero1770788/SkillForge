@model quiz_project.ViewModels.QuizStatisticsModel

<div class="stats-wrapper">
    <div class="d-flex justify-content-between align-items-center">
        <h3 class="stats-title">Here's statistics for @Model.Title</h3>
        @if (!string.IsNullOrEmpty(ViewBag.ReturnUrl as string))
        {
            <a href="@ViewBag.ReturnUrl" class="btn btn-danger text-white">Return</a>
        }
        else
        {
            <form asp-controller="Quiz" asp-action="Index" method="get">
                <button type="submit" class="btn btn-danger text-white">Return</button>
            </form>
        }
    </div>

    @{
        var quizSummaryViewModel = @Model.quizSummaryViewModel;
    }

    <div>
        <strong>Average points:</strong> @Model.AverageScore |
        <strong>Average percentage:</strong> @Model.ScorePercentage%
    </div>

    @if (quizSummaryViewModel.Score > 0 || quizSummaryViewModel.BestScore > 0)
    {
        <div class="stats-section-title">
            Your best attempt: @quizSummaryViewModel.Score / @quizSummaryViewModel.TotalScore
        </div>
    }

    <div class="stats-section-title">Leaderboard</div>
    <div>
        @for (int i = 0; i < @quizSummaryViewModel.TopPlayerScores.Count(); i++)
        {
            var playerScore = @quizSummaryViewModel.TopPlayerScores[i];

            <div class="leaderboard-entry" id="score-@i">
                <strong>@playerScore.UserName</strong> | score @playerScore.PlayerScore
            </div>
        }
    </div>

    @foreach (var question in @Model.quizSummaryViewModel.Questions)
    {
        var isOpen = question.Type == quiz_project.Entities.Definition.QuestionType.FillInTheBlank
                  || question.Type == quiz_project.Entities.Definition.QuestionType.OpenWithImage;
        <div class="question">
            <h5>@question.Description</h5>

            @if (!string.IsNullOrEmpty(question.ImagePath))
            {
                <img src="/Quiz/QuestionImage?path=@Uri.EscapeDataString(question.ImagePath)"
                     alt="Question image" class="img-fluid rounded mb-2" style="max-height:240px;" />
            }

            @if (isOpen && !string.IsNullOrEmpty(question.Keywords))
            {
                <p class="mb-1"><strong>Auto-graded keywords:</strong>
                    @foreach (var kw in question.Keywords.Split(',', System.StringSplitOptions.RemoveEmptyEntries))
                    {
                        <span class="badge bg-secondary me-1">@kw.Trim()</span>
                    }
                </p>
            }

            @if (isOpen)
            {
                <p class="text-muted small">Open-answer question-individual responses visible in attempt details.</p>
            }
            else
            {
                <ul>
                    @foreach (var answer in question.Answers)
                    {
                        var percentage = question.TotalAttempts > 0
                            ? Math.Round((double)answer.SelectedByCount / question.TotalAttempts * 100, 2)
                            : 0;
                        <li>
                            @answer.Description |
                            Chosen @answer.SelectedByCount times |
                            Percentage: @percentage%
                        </li>
                    }
                </ul>
            }
        </div>
    }
</div>
